          { "name": "kpi_id", "type": "uuid", "note": "nullable" },
          { "name": "insight_id", "type": "uuid", "note": "nullable" },
          { "name": "reason", "type": "text" },
          { "name": "status", "type": "text", "note": "pending / resolved" },
          { "name": "raised_at", "type": "timestamp" },
